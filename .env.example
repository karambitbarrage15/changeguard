# ChangeGuard Environment Configuration

# Ports
TELEMETRY_PORT=8000
RISK_ENGINE_PORT=8001
MCP_SERVER_PORT=8002
SRE_AGENT_PORT=8003
RAG_ENGINE_PORT=8004
DASHBOARD_PORT=3000
PROMETHEUS_PORT=9090
